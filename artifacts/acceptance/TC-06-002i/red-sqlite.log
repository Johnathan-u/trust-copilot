                },
            )
        elif case_name == "parent_deleted":
            c.db.delete(c.qnr)
        elif case_name == "parent_missing":
            c.payload["questionnaire_id"] = 2147483647
        elif case_name == "parent_without_file":
            c.qnr.storage_key = None
        persist_payload(c, c.payload)
