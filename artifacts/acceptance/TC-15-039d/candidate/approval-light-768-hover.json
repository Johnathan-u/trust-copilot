{
  "theme": "light",
  "width": 768,
  "hover": {
    "disabled": false,
    "disabledSelector": false,
    "focused": true,
    "color": "rgb(255, 255, 255)",
    "backgroundColor": "rgb(17, 94, 89)",
    "outlineWidth": "2px",
    "transitionProperty": "border-color, text-decoration-color, fill, stroke",
