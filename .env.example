# --- Database (Postgres) ---
POSTGRES_DB=trustcopilot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Use @postgres when API runs in Docker Compose; the API rewrites this to localhost when run on the host.
# For local uvicorn without Docker, you can set localhost explicitly: ...@localhost:5432/...
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/trustcopilot
# Max worker threads for batched retrieval (RetrievalService.batch_search). Each thread uses its own
# DB Session/connection (never the request's), and the total is also capped by the SQLAlchemy pool
# size (pool_size + max_overflow - 1). Default 8, allowed 1-32. Set 1 to run retrieval serially.
# RETRIEVAL_MAX_THREADS=8

# --- Session (auth cookie; change in production) ---
SESSION_SECRET=placeholder

# --- Email (optional; without SMTP_HOST invites/password-reset log to API stdout only) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# Dev only: return password-reset link in JSON (forgot-password) so UI works without inbox. Never enable in production.
# TRUST_COPILOT_DEV_RETURN_RESET_URL=1

# --- Slack and Gmail providers (TC-19-001) ---
# Runtime mode for both providers. Unset follows APP_ENV: production uses the HTTP
# providers (HttpSlackProvider, HttpGmailProvider); any other APP_ENV uses the
# labelled development stub. APP_ENV=production cannot be overridden to development.
# MESSAGE_PROVIDER_RUNTIME_MODE=development
# Explicit dev stub. true/1/yes selects the labelled stub outside production.
# false/0/no selects the HTTP providers. Unset: stub in development, HTTP in production.
# A true value with a production runtime fails startup preflight. The process does
# not fall back to the stub and does not report a Slack or Gmail delivery.
# MESSAGE_PROVIDER_DEV_STUB=1
# Real Slack and Gmail calls also need a workspace connection (pasted token until
# TC-19-002 / TC-19-005). There is no global bot token or Gmail refresh setting here.
# Sandbox qualification is owner-gated and is not enabled by these variables.

# --- App URLs (must match where the app is served; OAuth redirect_uri is built from APP_BASE_URL) ---
APP_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Trusted frontend origins for CORS and CSRF (login, API). Comma-separated. If unset: dev = FRONTEND_URL + localhost variants; prod = FRONTEND_URL only. Set when frontend runs on a different port (e.g. FRONTEND_URL=http://localhost:3003) or multiple origins.
# TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3003
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public Trust page (/trust) workspace; set to override default 1 (e.g. single-tenant or default workspace)
# NEXT_PUBLIC_TRUST_WORKSPACE_ID=1

# --- S3 / MinIO ---
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=placeholder
S3_SECRET_KEY=placeholder
S3_BUCKET_RAW=trustcopilot-raw
S3_BUCKET_EXPORTS=trustcopilot-exports
S3_USE_SSL=false

# --- OpenAI (required for embeddings and answer generation) ---
OPENAI_API_KEY=placeholder

# --- Optional: app behavior ---
EXPORT_ANSWER_COL_OFFSET=1
# MAX_UPLOAD_BYTES=52428800

# --- Optional: OAuth (Google, GitHub) and Auth0 SSO (uncomment and set to enable) ---
# For Google: in Cloud Console set Authorized redirect URI to {APP_BASE_URL}/api/auth/oauth/google/callback (e.g. http://localhost:3000/api/auth/oauth/google/callback)
# For GitHub: in OAuth App settings set Authorization callback URL to {APP_BASE_URL}/api/auth/oauth/github/callback
# OAUTH_GOOGLE_CLIENT_ID=placeholder
# OAUTH_GOOGLE_CLIENT_SECRET=placeholder
# OAUTH_GITHUB_CLIENT_ID=placeholder
# OAUTH_GITHUB_CLIENT_SECRET=placeholder
# OIDC_ISSUER_URL=placeholder
# OIDC_CLIENT_ID=placeholder
# OIDC_CLIENT_SECRET=placeholder
# OIDC_SCOPE=openid profile email
# OIDC_DEFAULT_WORKSPACE_ID=1
# IDME_CLIENT_ID=placeholder
# IDME_CLIENT_SECRET=placeholder
# IDME_REDIRECT_PATH=api/auth/idme/callback

# --- Stripe (buyer-owned account; placeholders only, never commit real keys) ---
# Create these in the buyer's own Stripe account. Amounts stay in Stripe, not here.
# Runbook: docs/release/tickets/TC-24-001.md
# STRIPE_SECRET_KEY=placeholder
# STRIPE_WEBHOOK_SECRET=placeholder
# Comma-separated secrets accepted during rotation, in addition to STRIPE_WEBHOOK_SECRET.
# STRIPE_WEBHOOK_SECRETS=placeholder
# STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
# test or live. Must match the secret-key prefix and each event's livemode flag.
# STRIPE_MODE=test
# Plan key to Stripe Price id. Do not put amounts here.
# STRIPE_PLAN_PRICE_IDS=pro:placeholder,pro_annual:placeholder
# Legacy price ids, used only when that plan key is absent from STRIPE_PLAN_PRICE_IDS.
# STRIPE_PRICE_ID=placeholder
# STRIPE_ANNUAL_PRICE_ID=placeholder
# STRIPE_MONTHLY_PLAN=pro
# STRIPE_ANNUAL_PLAN=pro_annual
# How long processed event ids are kept. Pruning never deletes inside the tolerance window.
# STRIPE_EVENT_RETENTION_SECONDS=604800

# --- Health probes (TC-03-003) ---
# /healthz = API liveness only (no dependencies). /readyz = DB + S3 within READINESS_TIMEOUT_SEC (503 otherwise).
# /workerz = worker heartbeat age vs WORKER_HEARTBEAT_STALE_SEC. Worker container probe: python -m app.probe worker
# READINESS_TIMEOUT_SEC=3
# WORKER_HEARTBEAT_INTERVAL_SEC=15
# WORKER_HEARTBEAT_STALE_SEC=120
# WORKER_JOB_MAX_RUNTIME_SEC=3600
# WORKER_LOOP_STALL_SEC=120
# WORKER_HEARTBEAT_FILE=/tmp/trustcopilot-worker.heartbeat
