# Environment and secrets — do not commit
.env
.env.*
!.env.example
apps/api/.env
apps/api/.env.*

# Dependencies and build
node_modules/
.next/
.next-e2e-sales/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# IDE and OS
.idea/
.vscode/
*.swp
.DS_Store

# Logs and temp
*.log
api_out.txt
api_err.txt

# Browser verification output (generated by scripts/verify-browser.js)
apps/web/verify-browser-results.json
apps/web/verify-browser-results.md

# E2E auth state (generated by playwright auth setup)
apps/web/e2e/.auth/

# TC-07-001: never commit cookie jars, debug traces or Playwright run output
# (they captured signed session cookies and test credentials).
*cookies*.txt
.curl_cookies*
.tmp_*
apps/web/playwright-report/
apps/web/test-results/
blob-report/
*.har
trace.zip
apps/api/.seed-credentials.local
.seed-credentials.local
# Generated local/test output — never commit (CI repair: these broke pre-commit end-of-file-fixer)
*.tsbuildinfo
apps/web/verify-ai-flows-results.json
apps/web/verify-review-ux-results.json
apps/api/test_results*.json
apps/api/seed-qa-out.txt
